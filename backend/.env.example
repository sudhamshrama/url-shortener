# Template for local development. Copy to .env and adjust.
#
#   cp .env.example .env
#
# .env is gitignored. This file is committed so a new contributor knows which
# variables exist without having to read the settings class — and so that adding
# a required variable is visible in a diff rather than discovered at runtime.
#
# Nothing here is a real credential. The Postgres password matches what
# docker-compose.yml sets for local development only; every deployed environment
# gets its value from a SealedSecret.

DATABASE_URL=postgresql+psycopg://shortener:shortener@localhost:5432/shortener

APP_VERSION=0.1.0-local
GIT_SHA=local

BASE_URL=http://localhost:8080

LOG_LEVEL=INFO

# Failure-injection endpoints (/debug/slow, /debug/error, /debug/leak).
# Local and the dev overlay only. Never staging, never prod.
ENABLE_DEBUG_ENDPOINTS=true
